// SkillStamp — Firestore Security Rules
// Principle: least privilege. Every collection is locked by default.
// Users can only write what they own. Admin collections are backend-only.
// Version: 2026-10 — makeshift backend: money/rep/verification fields are
// protected by rules because Cloud Functions are not available (Spark plan).
// See RULES_CHANGES.md for what changed and what is still not covered.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════
    //  HELPERS
    // ═══════════════════════════════════════════════════════════════════════

    // Caller is signed in
    function isAuth() {
      return request.auth != null;
    }

    // Caller owns this document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Caller is the admin — checked against the user's OWN Firestore doc
    // (never trusts custom claims alone)
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Caller is not banned
    function isNotBanned() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.badgeStatus != 'suspended' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned != true;
    }

    // Field is unchanged between incoming and existing doc
    function fieldUnchanged(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // Field has the same value before and after (missing counts as null).
    // Safe for fields that may not exist on older documents.
    function same(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ── Wallet helpers (a wallet is {balance, pending, earned, transactions}) ──
    function wb(w)  { return w.get('balance', 0); }
    function wp(w)  { return w.get('pending', 0); }
    function we(w)  { return w.get('earned', 0); }
    function wtx(w) { return w.get('transactions', []); }

    // A brand-new account must start with an empty wallet and no reputation.
    function startsClean(d) {
      return (!('wallet' in d) ||
               (wb(d.wallet) == 0 && wp(d.wallet) == 0 && we(d.wallet) == 0 && wtx(d.wallet).size() == 0)) &&
             d.get('repPoints', 0) == 0 &&
             d.get('score', 0) == 0 &&
             d.get('gigsCount', 0) == 0 &&
             d.get('earned', 0) == 0;
    }

    // Collecting payment for a gig the client marked completed. The wallet must
    // grow by exactly the payout (gig escrow minus the 10% fee), the newest
    // transaction must be 'pay_<gigId>', and that gig must be completed and
    // assigned to the caller.
    function claimOk(ow, nw) {
      let d    = wb(nw) - wb(ow);
      let txid = wtx(nw)[0].id;
      let g    = get(/databases/$(database)/documents/gigs/$(txid.replace('pay_', ''))).data;
      return d > 0 &&
             we(nw) - we(ow) == d &&
             wp(nw) == wp(ow) &&
             txid.matches('pay_[A-Za-z0-9_-]+') &&
             g.status == 'completed' &&
             g.hiredUid == request.auth.uid &&
             d * 10 <= g.escrowAmount * 9 + 5;
    }

    // The only ways a user may change their OWN wallet:
    //  A) money only moves or leaves (escrow, withdraw, send, release):
    //     balance + pending can never go UP and `earned` can't change.
    //  B) test top-up: at most $50, with a matching 'Top Up' transaction.
    //  C) one-time $1,000 demo credit on an empty wallet history (test mode).
    //  D) payout for a completed gig (see claimOk).
    function walletMoveOk(ow, nw) {
      return wb(nw) >= 0 && wp(nw) >= 0 && we(nw) >= 0 && (
        (we(nw) == we(ow) && wb(nw) + wp(nw) <= wb(ow) + wp(ow)) ||
        (we(nw) == we(ow) && wp(nw) == wp(ow) &&
          wb(nw) > wb(ow) && wb(nw) - wb(ow) <= 50 &&
          wtx(nw)[0].type == 'in' && wtx(nw)[0].from == 'Top Up' &&
          wtx(nw)[0].amount == wb(nw) - wb(ow)) ||
        (we(nw) == we(ow) && wp(nw) == wp(ow) &&
          wb(nw) - wb(ow) == 1000 && wtx(ow).size() == 0 &&
          wtx(nw)[0].id == 't_welcome') ||
        claimOk(ow, nw)
      );
    }

    function walletUpdateOk() {
      let ow = resource.data.get('wallet', {'balance': 0, 'pending': 0, 'earned': 0, 'transactions': []});
      return !('wallet' in request.resource.data) ||
             request.resource.data.wallet == ow ||
             walletMoveOk(ow, request.resource.data.wallet);
    }

    // Reputation can only creep up in small steps and a rating stays 0–5.
    // (Large jumps need an admin.)
    function statsUpdateOk() {
      return request.resource.data.get('repPoints', 0) <= resource.data.get('repPoints', 0) + 30 &&
             request.resource.data.get('gigsCount', 0) <= resource.data.get('gigsCount', 0) + 1 &&
             request.resource.data.get('score', 0) >= 0 &&
             request.resource.data.get('score', 0) <= 5 &&
             same('earned');
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  USERS COLLECTION
    //  - Anyone signed in can read profiles (needed for talent browse)
    //  - Users can only update their OWN document
    //  - Users CANNOT elevate isAdmin, change another user's role, or unban themselves
    //  - Admin gets full write access
    // ═══════════════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if isAuth();

      // Only the user themselves can create their own profile (during signup)
      allow create: if isOwner(uid) &&
                       request.resource.data.isAdmin == false &&
                       request.resource.data.isBanned == false &&
                       request.resource.data.badgeStatus in ['beginner'] &&
                       // Cannot start with free money / reputation
                       startsClean(request.resource.data);

      // User can update their own profile, with restrictions
      allow update: if isOwner(uid) &&
                       // Cannot promote themselves to admin
                       fieldUnchanged('isAdmin') &&
                       // Cannot change their ban status
                       fieldUnchanged('isBanned') &&
                       // Cannot change their badge/verification status
                       fieldUnchanged('badgeStatus') &&
                       // Cannot change another user's uid
                       fieldUnchanged('uid') &&
                       // Cannot change email (Firebase Auth handles this)
                       fieldUnchanged('email') &&
                       // Verification data is issued by admins only
                       same('skillId') &&
                       same('verifiedSkills') &&
                       // Wallet, reputation and rating are rule-guarded
                       walletUpdateOk() &&
                       statsUpdateOk();

      // Admin can write anything (used for ban, badge, verify operations)
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  AVATARS COLLECTION
    //  Separate collection to keep user docs small.
    //  Only the owner can write their own avatar.
    // ═══════════════════════════════════════════════════════════════════════
    match /avatars/{uid} {
      allow read:  if isAuth();
      allow write: if isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  GIGS COLLECTION
    //  - Anyone signed in can read gigs
    //  - Only authenticated, non-banned users can create gigs
    //  - Only the poster can update their own gig
    //  - Payment fields (escrowAmount, status=completed) are backend-only
    // ═══════════════════════════════════════════════════════════════════════
    match /gigs/{gigId} {
      allow read: if isAuth();

      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.posterUid == request.auth.uid &&
                       request.resource.data.status in ['open'];

      allow update: if isAuth() && isNotBanned() &&
                       // Only the poster can update the gig
                       resource.data.posterUid == request.auth.uid &&
                       // Cannot change who posted it
                       fieldUnchanged('posterUid') &&
                       // Once someone is hired the money terms are frozen
                       (resource.data.get('hiredUid', null) == null ||
                         (same('escrowAmount') && same('pay') && same('hiredUid'))) &&
                       // A gig can only be completed after somebody was hired
                       (request.resource.data.status != 'completed' ||
                         resource.data.status == 'completed' ||
                         (resource.data.status in ['hired', 'delivered', 'in_progress'] &&
                          resource.data.get('hiredUid', null) != null));

      // Allow freelancer to update their delivery
      allow update: if isAuth() && isNotBanned() &&
                       resource.data.hiredUid == request.auth.uid &&
                       // Freelancer can ONLY touch delivery fields — everything else
                       // (pay, hiredUid, escrowAmount…) must stay as it was.
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'deliveryLink', 'deliveryNote', 'deliveredAt', 'autoReleaseAt',
                         'lastRevisionNote', 'revisionCount', 'status'
                       ]) &&
                       // …and `status` may only change to 'disputed' (raising a dispute)
                       (same('status') ||
                         (resource.data.status == 'hired' && request.resource.data.status == 'disputed'));

      // Allow any non-banned freelancer (who is not the poster) to APPLY to an
      // open gig — this adds their own uid to `applicants` and their own entry
      // to `proposals`. They may only touch these two fields, may only append
      // (never remove/reorder) applicants, may only add themselves once, and
      // may only write/modify their own key inside `proposals` — never another
      // applicant's data.
      allow update: if isAuth() && isNotBanned() &&
                       resource.data.status == 'open' &&
                       resource.data.posterUid != request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants', 'proposals']) &&
                       // Exactly one new applicant appended, and it must be the caller
                       request.resource.data.applicants.size() == resource.data.applicants.size() + 1 &&
                       request.resource.data.applicants.hasAll(resource.data.applicants) &&
                       !resource.data.applicants.hasAny([request.auth.uid]) &&
                       request.resource.data.applicants[request.resource.data.applicants.size() - 1] == request.auth.uid &&
                       // proposals map: only the caller's own key may change
                       (!('proposals' in resource.data) ||
                         request.resource.data.proposals.diff(resource.data.proposals).affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if isAuth() &&
                       resource.data.posterUid == request.auth.uid &&
                       resource.data.status == 'open';

      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  CONVERSATIONS COLLECTION
    //  Only participants can read/write their own conversation.
    //  Direct Firestore writes are still allowed here for the legacy
    //  frontend flow — the Cloud Function adds server-side validation on top.
    // ═══════════════════════════════════════════════════════════════════════
    match /conversations/{convId} {
      allow read:   if isAuth() &&
                       request.auth.uid in resource.data.participants;

      allow create: if isAuth() && isNotBanned() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() == 2;

      allow update: if isAuth() && isNotBanned() &&
                       request.auth.uid in resource.data.participants &&
                       // Cannot add/remove people from a conversation
                       request.resource.data.participants == resource.data.participants;

      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  POSTS COLLECTION
    //  Authenticated non-banned users can create posts.
    //  Only the author can delete their own post.
    // ═══════════════════════════════════════════════════════════════════════
    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() &&
                       resource.data.uid == request.auth.uid;
      allow delete: if isAuth() &&
                       resource.data.uid == request.auth.uid;
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  ENDORSEMENTS COLLECTION
    //  Authenticated non-banned users can create endorsements.
    // ═══════════════════════════════════════════════════════════════════════
    match /endorsements/{endorseId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.fromUid == request.auth.uid &&
                       // Cannot endorse yourself
                       request.resource.data.fromUid != request.resource.data.toUid;
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  PROPOSALS COLLECTION
    //  Only sender and recipient can read a proposal.
    //  Only the sender can create. Only the recipient can accept/reject.
    // ═══════════════════════════════════════════════════════════════════════
    match /proposals/{proposalId} {
      allow read: if isAuth() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid   == request.auth.uid);

      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.fromUid == request.auth.uid &&
                       request.resource.data.status == 'pending';

      // Only the recipient can accept or reject
      allow update: if isAuth() && isNotBanned() &&
                       resource.data.toUid == request.auth.uid &&
                       resource.data.status == 'pending' &&
                       request.resource.data.status in ['accepted', 'rejected'] &&
                       fieldUnchanged('fromUid') &&
                       fieldUnchanged('toUid') &&
                       fieldUnchanged('budget');

      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  NOTIFICATIONS COLLECTION
    //  Users can only read/update their own notifications.
    //  Creates come from backend functions only (except pushNotif frontend helper).
    // ═══════════════════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && isNotBanned();
      allow update: if isAuth() &&
                       resource.data.uid == request.auth.uid &&
                       // Can only mark as read — no other field changes
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  SKILL VERIFICATIONS — submitted by users, reviewed by admin
    // ═══════════════════════════════════════════════════════════════════════
    match /skillVerifications/{svId} {
      allow read:   if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == 'pending';
      // Only admin can approve/reject (via backend function)
      allow update: if isAdmin();
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  DISPUTES — raised by participants, resolved by admin
    // ═══════════════════════════════════════════════════════════════════════
    match /disputes/{disputeId} {
      allow read:   if isAuth() && (resource.data.raisedBy == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBanned() &&
                       request.resource.data.raisedBy == request.auth.uid;
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  ANALYTICS — write-only for authenticated users (via Cloud Function)
    //  Reads are admin-only. Direct writes are allowed for frontend fallback.
    // ═══════════════════════════════════════════════════════════════════════
    match /analytics_events/{eventId} {
      allow create: if isAuth();
      allow read:   if isAdmin();
      allow write:  if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  ADMIN AUDIT LOG — backend write only, admin read only
    // ═══════════════════════════════════════════════════════════════════════
    match /admin_audit_log/{logId} {
      allow read:  if isAdmin();
      allow write: if false; // Only Cloud Functions (Admin SDK) can write here
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  META — maintenance mode flag (admin write, anyone can read)
    // ═══════════════════════════════════════════════════════════════════════
    match /meta/{docId} {
      allow read:  if true;    // maintenance banner needs public read
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════
    //  DEFAULT DENY — everything else is blocked
    // ═══════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
